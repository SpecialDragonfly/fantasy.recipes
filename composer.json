{
    "name": "notquitehuman/fantasy-recipes",
    "description": "fantasy.recipes -- a recipe site where every recipe is a fantasy ritual.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "guzzlehttp/guzzle": "^7.8",
        "php-di/php-di": "^7.0",
        "slim/csrf": "^1.4",
        "slim/psr7": "^1.6",
        "slim/slim": "^4.12",
        "slim/twig-view": "^3.3",
        "symfony/console": "^7.0",
        "symfony/http-client": "^7.0",
        "symfony/mailer": "^7.0",
        "symfony/resend-mailer": "^7.0",
        "twig/twig": "^3.8",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^10.5",
        "robmorgan/phinx": "^0.16"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    }
}
