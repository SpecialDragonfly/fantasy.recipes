{% extends 'layout.twig' %}

{% block title %}{{ recipe.title }} - Fantasy Recipes{% endblock %}

{% block head_extra %}
    {% if recipeJsonLd %}
        {# Already-serialized JSON, not HTML -- see App\Http\RecipeJsonLd's
           docblock for why |raw is correct here rather than a bug. #}
        <script type="application/ld+json">{{ recipeJsonLd|raw }}</script>
    {% endif %}
{% endblock %}

{% block content %}
    <div class="ad-slot ad-leaderboard">Advertisement</div>

    <div class="recipe-with-ads">
        <aside class="ad-slot ad-skyscraper">Advertisement</aside>

        <article>
            <h1>{{ recipe.title }}</h1>

            {% if tags|length %}
                <p class="recipe-tags">
                    {% for tag in tags %}
                        <a href="/recipes?tag={{ tag.id }}">{{ tag.name }}</a>{% if not loop.last %} &middot; {% endif %}
                    {% endfor %}
                </p>
            {% endif %}

            {#
                Bookmark toggle -- Grimoire is a logged-in-User privilege
                (spec.md -- Roles & Permissions), so a guest gets a login
                prompt instead of the button. return_to sends the add/remove
                POST back to this same recipe page (grimoireReturnTo() in
                user.php) rather than the default /grimoire, so bookmarking
                mid-read doesn't yank the reader away from the recipe.
            #}
            {% if current_user %}
                <p class="grimoire-toggle">
                    {% if inGrimoire %}
                        <form method="post" action="/grimoire/{{ recipe.id }}/remove" class="inline-form">
                            {% include 'partials/_csrf.twig' %}
                            <input type="hidden" name="return_to" value="/recipes/{{ recipe.slug }}">
                            <button type="submit" class="link-button">&#9733; In your Grimoire - remove</button>
                        </form>
                    {% else %}
                        <form method="post" action="/grimoire/{{ recipe.id }}" class="inline-form">
                            {% include 'partials/_csrf.twig' %}
                            <input type="hidden" name="return_to" value="/recipes/{{ recipe.slug }}">
                            <button type="submit" class="link-button">&#9734; Add to Grimoire</button>
                        </form>
                    {% endif %}
                </p>
            {% else %}
                <p class="grimoire-toggle">
                    <small><a href="/login?next={{ ('/recipes/' ~ recipe.slug)|url_encode }}">Log in</a> to add this
                        to your Grimoire.</small>
                </p>
            {% endif %}

            {% if story %}
                <section class="panel narrator-story">
                    {% if recipe.narrator %}<p class="story-narrator"><em>Told by {{ recipe.narrator }}</em></p>{% endif %}
                    <div class="story-body">{{ story.body|nl2br }}</div>
                </section>
            {% endif %}

            <section class="panel narrator-recipe">
                <div class="instruction-text">{{ recipe.narrator_recipe|default('This ritual has not yet been translated.')|nl2br }}</div>
            </section>

            <details class="mundane-truth">
                <summary>Reveal the mundane truth</summary>
                <section class="panel">
                    <div class="instruction-text">{{ recipe.original_ingredients|nl2br }}</div>
                    <div class="instruction-text">{{ recipe.original_instructions|nl2br }}</div>
                </section>
            </details>
        </article>

        <aside class="ad-slot ad-skyscraper ad-skyscraper-editable">Editable space</aside>
    </div>
{% endblock %}
