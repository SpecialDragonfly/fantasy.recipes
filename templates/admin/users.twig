{% extends 'layout.twig' %}

{% block title %}Admin: Users - Fantasy Recipes{% endblock %}

{% block content %}
    <section class="panel">
        <h1>Users</h1>

        <p>{{ users|length }} account{{ users|length == 1 ? '' : 's' }}.</p>

        {% if users|length %}
            <table class="queue-table">
                <thead>
                    <tr>
                        <th>Username</th>
                        <th>Email</th>
                        <th>Role</th>
                        <th>Marketing</th>
                        <th>Signed up</th>
                        <th>Last login</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for user in users %}
                        <tr>
                            <td>{{ user.username }}</td>
                            <td>{{ user.email }}</td>
                            <td>{{ user.role }}</td>
                            <td>{{ user.marketing_opt_in ? 'Yes' : 'No' }}{% if user.marketing_opt_in and user.marketing_opt_in_at %} <small>since {{ user.marketing_opt_in_at }}</small>{% endif %}</td>
                            <td>{{ user.created_at }}</td>
                            <td>{{ user.last_login_at ?? 'never' }}</td>
                            <td class="queue-actions">
                                {% if user.id == current_user_id %}
                                    <small>you</small>
                                {% else %}
                                    <form method="post" action="/admin/users/{{ user.id }}/delete" class="inline-form"
                                          onsubmit="return confirm('Delete {{ user.username|e('js') }}? This also removes their Grimoire and personal recipes and cannot be undone.');">
                                        {% include 'partials/_csrf.twig' %}
                                        <button type="submit" class="link-button">Delete</button>
                                    </form>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% else %}
            <p>No accounts yet.</p>
        {% endif %}
    </section>
{% endblock %}
