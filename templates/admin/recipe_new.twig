{% extends 'layout.twig' %}

{% block title %}New recipe - fantasy.recipes{% endblock %}

{% block content %}
    <section class="auth-form">
        <h1>New recipe</h1>
        <p><small>Importing from a URL instead? Use <a href="/admin/recipes/import">Import a recipe</a> -- it
            creates the draft for you, ready to edit here. This form is for a manually-entered recipe with no
            source URL at all.</small></p>
        {% if errors is defined and errors|length %}
            <ul class="form-errors">
                {% for error in errors %}<li>{{ error }}</li>{% endfor %}
            </ul>
        {% endif %}
        <form method="post" action="/admin/recipes">
            {% include 'partials/_csrf.twig' %}

            <label for="slug">Slug</label>
            <input type="text" id="slug" name="slug" value="{{ old.slug|default('') }}"
                   required pattern="[a-z0-9]+(-[a-z0-9]+)*" placeholder="dragons-breath-stew">

            <label for="title">Title</label>
            <input type="text" id="title" name="title" value="{{ old.title|default('') }}"
                   required maxlength="255" placeholder="Dragon's Breath Stew">

            <label for="origin">Origin <small>(a source URL, or a plain description -- e.g. "BBC Good Food,
                imported by hand" -- optional)</small></label>
            <input type="text" id="origin" name="origin" value="{{ old.origin|default('') }}" maxlength="512">

            <label for="original_ingredients">Ingredients <small>(the mundane truth -- carried through close to
                verbatim, a list of ingredients is a fact, not an expression)</small></label>
            <textarea id="original_ingredients" name="original_ingredients"
                      rows="8">{{ old.original_ingredients|default('') }}</textarea>

            <label for="original_instructions">Instructions <small>(plain, functional -- in your own words, never
                copied verbatim from a source)</small></label>
            <textarea id="original_instructions" name="original_instructions"
                      rows="8">{{ old.original_instructions|default('') }}</textarea>

            <label>
                <input type="checkbox" name="published" value="1" {% if old.published|default(false) %}checked{% endif %}>
                Published
            </label>

            <button type="submit">Create</button>
        </form>
        <p>Narrator, the ritual-styled recipe, a Story, and tags can all be added once the recipe exists -- you'll
            land on its edit page after creating it.</p>
    </section>
{% endblock %}
