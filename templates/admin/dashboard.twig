{% extends 'layout.twig' %}

{% block title %}Admin - Fantasy Recipes{% endblock %}

{% block content %}
    <section class="panel">
        <h1>Admin</h1>
        <ul>
            <li><a href="/admin/recipes">Recipes</a> ({{ recipeCount }})</li>
            <li><a href="/admin/recipes?status=draft">Drafts still in progress</a> ({{ draftCount }})</li>
            <li><a href="/admin/recipes/import">Import a recipe</a></li>
            <li><a href="/admin/tags">Tags</a></li>
            <li><a href="/admin/mail-queue">Recipe-email queue</a></li>
        </ul>
        <p><small>Paste a URL from BBC Good Food, HelloFresh, Riverford, or most other sites with structured
            recipe data, and it lands here as a draft ready to rewrite, tag, and translate.</small></p>
    </section>
{% endblock %}
