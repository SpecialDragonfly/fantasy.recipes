{% extends 'layout.twig' %}

{% block title %}Register - fantasy.recipes{% endblock %}

{% block content %}
    <section class="auth-form">
        <h1>Register</h1>
        {% if errors is defined and errors|length %}
            <ul class="form-errors">
                {% for error in errors %}<li>{{ error }}</li>{% endfor %}
            </ul>
        {% endif %}
        <form method="post" action="/register">
            {% include 'partials/_csrf.twig' %}

            <label for="username">Username</label>
            <input type="text" id="username" name="username" value="{{ old.username|default('') }}"
                   required minlength="3" maxlength="64" autocomplete="username">

            <label for="email">Email</label>
            <input type="email" id="email" name="email" value="{{ old.email|default('') }}"
                   required maxlength="255" autocomplete="email">

            <label for="password">Password</label>
            <input type="password" id="password" name="password"
                   required minlength="8" autocomplete="new-password">

            <button type="submit">Create account</button>
        </form>
        <p>Already have an account? <a href="/login">Login</a>.</p>
    </section>
{% endblock %}
