{% extends 'layout.twig' %}

{% block title %}Reset your password - Fantasy Recipes{% endblock %}

{% block content %}
    <section class="auth-form">
        <h1>Reset your password</h1>
        {% if errors is defined and errors|length %}
            <ul class="form-errors">
                {% for error in errors %}<li>{{ error }}</li>{% endfor %}
            </ul>
        {% endif %}
        <p>Enter the email address on your account and we'll send you a link to choose a new password.</p>
        <form method="post" action="/password-reset">
            {% include 'partials/_csrf.twig' %}

            <label for="email">Email</label>
            <input type="email" id="email" name="email" value="{{ old.email|default('') }}"
                   required maxlength="255" autocomplete="email">

            <button type="submit">Send reset link</button>
        </form>
        <p><a href="/login">Back to login</a></p>
    </section>
{% endblock %}
