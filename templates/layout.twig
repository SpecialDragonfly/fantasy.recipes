<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Fantasy Recipes{% endblock %}</title>
    {% include 'partials/_favicons.twig' %}
    <link rel="stylesheet" href="/css/site.css?v={{ asset_version }}">
    {% block head_extra %}{% endblock %}
</head>
<body class="framed">
{# No header bar. Top-left: a small wordmark linking home (the landing has
   its own hero wordmark, so this is layout.twig only). Top-right: the same
   "Menu" dropdown as the landing (partials/_menu.twig). #}
<a class="site-logo" href="/">Fantasy Recipes</a>
{% include 'partials/_menu.twig' with { show_home: true } %}
<div class="content-container">
<main>
    {% for message in flash_messages %}
        <p class="flash flash-{{ message.type }}">{{ message.text }}</p>
    {% endfor %}
    {% block content %}{% endblock %}
</main>
<footer class="site-footer">
    <p>Fantasy Recipes - every recipe is a ritual.</p>
    <p><a href="/terms">Terms &amp; conditions</a></p>
</footer>
<script src="/js/site.js?v={{ asset_version }}" defer></script>
</body>
</html>
