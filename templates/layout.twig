<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Fantasy Recipes{% endblock %}</title>
    {% include 'partials/_favicons.twig' %}
    {# Defaults for the SEO partial. Declared inside a never-true `if` so they
       register as overridable blocks without rendering here. #}
    {% if false %}
        {% block meta_description %}{% endblock %}
        {% block canonical_path %}{{ request.uri.path }}{% endblock %}
        {% block robots %}noindex,nofollow{% endblock %}
        {% block og_type %}website{% endblock %}
    {% endif %}
    {# Pages are noindex unless they opt in by overriding `robots` -- public
       content pages do, account/admin/auth/search-result pages and the 404
       stay out of the index by default. #}
    {% include 'partials/_seo.twig' with {
        seo_title: block('title')|striptags,
        seo_description: block('meta_description'),
        seo_path: block('canonical_path'),
        seo_robots: block('robots'),
        seo_type: block('og_type'),
        app_url: app_url,
    } only %}
    <link rel="stylesheet" href="/css/site.css?v={{ asset_version }}">
    {% block head_extra %}{% endblock %}
</head>
<body class="framed">
{# No header bar. Top-left: a small wordmark linking home (the landing has
   its own hero wordmark, so this is layout.twig only). Top-right: the same
   "Menu" dropdown as the landing (partials/_menu.twig). #}
<a class="site-logo" href="/">Fantasy Recipes</a>
{% include 'partials/_menu.twig' with { show_home: true } %}
<div class="content-container">
<main>
    {% for message in flash_messages %}
        <p class="flash flash-{{ message.type }}">{{ message.text }}</p>
    {% endfor %}
    {% block content %}{% endblock %}
</main>
<footer class="site-footer">
    <p>Fantasy Recipes - every recipe is a ritual.</p>
    <p><a href="/terms">Terms &amp; conditions</a></p>
</footer>
<script src="/js/site.js?v={{ asset_version }}" defer></script>
</body>
</html>
