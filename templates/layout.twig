<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}fantasy.recipes{% endblock %}</title>
    <link rel="stylesheet" href="/css/site.css?v={{ asset_version }}">
    {% block head_extra %}{% endblock %}
</head>
<body>
<header class="site-header">
    <nav class="site-nav">
        <a href="/" class="site-brand">fantasy.recipes</a>
        <ul class="site-nav-links">
            <li><a href="/recipes">Recipes</a></li>
            <li><a href="/writers">Our Writers</a></li>
            <li><a href="/search">Search</a></li>
            {% if current_user %}
                <li><a href="/grimoire">Grimoire</a></li>
                {% if current_user.role == 'admin' %}
                    <li><a href="/admin">Admin</a></li>
                {% endif %}
                <li class="site-nav-user">{{ current_user.username }}</li>
                <li>
                    <form method="post" action="/logout" class="inline-form">
                        {% include 'partials/_csrf.twig' %}
                        <button type="submit" class="link-button">Logout</button>
                    </form>
                </li>
            {% else %}
                <li><a href="/login">Login</a></li>
                <li><a href="/register">Register</a></li>
            {% endif %}
            <li>
                <button type="button" id="theme-toggle" aria-label="Toggle dark mode">🌓</button>
            </li>
        </ul>
    </nav>
</header>
<div class="content-container">
<main>
    {% for message in flash_messages %}
        <p class="flash flash-{{ message.type }}">{{ message.text }}</p>
    {% endfor %}
    {% block content %}{% endblock %}
</main>
<footer class="site-footer">
    <p>fantasy.recipes &mdash; every recipe is a ritual.</p>
</footer>
<script src="/js/site.js" defer></script>
</body>
</html>
