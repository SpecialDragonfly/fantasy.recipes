<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}fantasy.recipes{% endblock %}</title>
    {% include 'partials/_favicons.twig' %}
    <link rel="stylesheet" href="/css/site.css?v={{ asset_version }}">
    {% block head_extra %}{% endblock %}
</head>
<body class="framed">
{# No header bar -- navigation is the same "Menu" dropdown as the landing
   page, floating top-right (see partials/_menu.twig). show_home adds a link
   back to the landing. #}
{% include 'partials/_menu.twig' with { show_home: true } %}
<div class="content-container">
<main>
    {% for message in flash_messages %}
        <p class="flash flash-{{ message.type }}">{{ message.text }}</p>
    {% endfor %}
    {% block content %}{% endblock %}
</main>
<footer class="site-footer">
    <p>fantasy.recipes - every recipe is a ritual.</p>
    <p><a href="/terms">Terms &amp; conditions</a></p>
</footer>
<script src="/js/site.js" defer></script>
</body>
</html>
