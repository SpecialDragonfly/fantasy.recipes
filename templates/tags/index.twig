{% extends 'layout.twig' %}

{% block title %}Tags - Fantasy Recipes{% endblock %}
{% block meta_description %}Every tag in the Fantasy Recipes collection, for finding dishes by realm, creature or occasion.{% endblock %}
{% block canonical_path %}/tags{% endblock %}
{% block robots %}index,follow{% endblock %}

{% block content %}
    <h1>Tags</h1>

    {% if tags|length %}
        <ul class="tag-index-list">
            {% for tag in tags %}
                <li><a href="/recipes?tag={{ tag.id }}">{{ tag.name }}</a></li>
            {% endfor %}
        </ul>
    {% else %}
        <p class="panel">No tags yet.</p>
    {% endif %}
{% endblock %}
