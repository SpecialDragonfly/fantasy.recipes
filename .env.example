# Copy to .env for Docker/MySQL use.
# See architecture.md -- Deployment & Networking for the reverse-proxy and
# host.docker.internal notes this configuration relies on.

APP_ENV=production
APP_DEBUG=false
APP_URL=https://recipes.notquitehuman.co.uk

DB_DRIVER=mysql
DB_HOST=host.docker.internal
DB_PORT=3306
DB_DATABASE=fantasy_recipes
DB_USERNAME=
DB_PASSWORD=

# Session cookie signing / other app-level secrets.
SESSION_SECRET=

# Used by recipe:translate-draft (see architecture.md -- CLI Commands).
CLAUDE_API_KEY=

# Transactional email, password reset only (see architecture.md -- Mail).
# MAIL_API_KEY is a Resend "Sending access" API key (re_...). Blank = mail
# is written to storage/mail/ instead of sent (LogMailer). MAIL_FROM_ADDRESS
# must be on a domain verified in Resend.
MAIL_API_KEY=
MAIL_FROM_ADDRESS=noreply@fantasyrecipes.co.uk
MAIL_FROM_NAME="Fantasy Recipes"

# Used by recipe:scrape (see config/scrape_sources.php) -- identifies this
# scraper to the sites it fetches from. Both optional; sensible defaults
# apply if unset. Consider including contact info in SCRAPER_USER_AGENT
# (e.g. an email/URL) as a courtesy to site operators -- left blank by
# default rather than assumed.
SCRAPER_USER_AGENT=
SCRAPER_RATE_LIMIT_DELAY_SECONDS=
