# Copy to .env.testing for local PHPUnit runs against SQLite -- no MySQL
# dependency required. See architecture.md -- Testing Strategy.

APP_ENV=testing
APP_DEBUG=true
APP_URL=http://localhost

DB_DRIVER=sqlite
DB_SQLITE_PATH=./storage/testing.sqlite

SESSION_SECRET=test-secret-not-for-production

MAIL_API_KEY=
MAIL_FROM_ADDRESS=noreply@fantasy.recipes
MAIL_FROM_NAME="fantasy.recipes"

# See .env.example. Left unset here on purpose; the importer's own tests
# never make real HTTP requests either way.
SCRAPER_USER_AGENT=
