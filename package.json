{
  "name": "fantasy-recipes-assets",
  "private": true,
  "scripts": {
    "build": "esbuild assets/css/site.css --minify --outfile=public/css/site.css && esbuild assets/js/site.js --minify --outfile=public/js/site.js",
    "watch": "esbuild assets/css/site.css --outfile=public/css/site.css --watch & esbuild assets/js/site.js --outfile=public/js/site.js --watch",
    "prepare": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "esbuild": "0.25.0"
  }
}
